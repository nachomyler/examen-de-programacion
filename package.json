{
  "name": "skytrack-airlines",
  "version": "1.0.0",
  "description": "SkyTrack Airlines - Sistema de Gestión de Vuelos",
  "private": true,
  "scripts": {
    "install:all": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "setup": "npm run install:all && npm run setup:backend",
    "setup:backend": "cd backend && npm run prisma:generate && npm run prisma:migrate && npm run build && npm run seed",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm run preview",
    "test:backend": "cd backend && npm test",
    "prisma:generate": "cd backend && npm run prisma:generate",
    "prisma:migrate": "cd backend && npm run prisma:migrate",
    "prisma:studio": "cd backend && npm run prisma:studio",
    "seed": "cd backend && npm run seed"
  },
  "keywords": [
    "airlines",
    "flight-management",
    "typescript",
    "react",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

